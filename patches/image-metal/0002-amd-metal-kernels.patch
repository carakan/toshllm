+                }
+            }
+            for (short rr = 0; rr < NQR; ++rr) {
+                for (short dd = 0; dd < NDC; ++dd) {
+                    acc[rr][dd] += (float) pacc[rr][dd][0] + (float) pacc[rr][dd][1];
