+        }
+        const float inv = srun[rr] > 0.0f ? 1.0f/srun[rr] : 0.0f;
+        const int64_t rid = (int64_t) iq3*args.ne2*args.ne1 + iq2 + (int64_t) iq*args.ne1;
+        for (short dd = 0; dd < NDC; ++dd) {
+            if (DV % 16 == 0 || kg + 16*dd < DV) {
+                dst1[rid*DV + kg + 16*dd] = acc[rr][dd]*inv;
+            }
+        }
+    }
