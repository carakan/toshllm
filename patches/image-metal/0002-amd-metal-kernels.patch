+        for (short c = tiitg; c < BK*DK4; c += NT) {
+            const short jj = c / DK4;
+            const short ch = c % DK4;
+            float4 tv = 0.0f;
+            if (j0 + jj < args.ne11) {
+                device const k_t * kb = (device const k_t *) (kp + (uint64_t)(j0 + jj)*args.nb11);
