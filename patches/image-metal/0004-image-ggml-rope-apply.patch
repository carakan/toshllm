+// Apply precomputed rotary matrices (ggml_rope_apply): pe carries [[cos, -sin], [sin, cos]]
+// for each pair of the head dimension and each token, shared across heads and batches.
+// The CPU implementation this replaces moved every attention's q and k to the host on each
+// step, which was most of the DiT's time on MOSS-Image and Qwen-Image.
+kernel void kernel_rope_apply_f32(
+        constant ggml_metal_kargs_rope_apply & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        ushort  tiitg[[thread_index_in_threadgroup]],
+        ushort3 tptg [[threads_per_threadgroup]],
+        uint3   tgpig[[threadgroup_position_in_grid]]) {
+    const int head  = tgpig[0];
+    const int token = tgpig[1];
+    const int batch = tgpig[2];
 
+    device const char * x_row = src0 + head*args.nb01 + token*args.nb02 + batch*args.nb03;
+
+    // the destination is contiguous: [head_dim, tokens, heads*batch]
+    const uint64_t out_row = ((uint64_t) token + (uint64_t) args.ne02*((uint64_t) head + (uint64_t) args.ne01*batch))*(uint64_t) args.ne00;
+    device float * out = (device float *) dst + out_row;
+
+    for (int j = tiitg; j < args.half_dim; j += tptg.x) {
+        const int i0 = args.interleaved ? 2*j : j;
+        const int i1 = args.interleaved ? 2*j + 1 : j + args.half_dim;
+
+        const float a = *(device const float *) (x_row + i0*4);
+        const float b = *(device const float *) (x_row + i1*4);
+
+        device const char * m = src1 + j*args.pe_nb2 + token*args.pe_nb3;
+
+        const float c = *(device const float *) (m);
+        const float s = *(device const float *) (m + args.pe_nb1);
+        if (args.interleaved) {
+            const float neg_s = *(device const float *) (m + args.pe_nb0);
+            const float c1    = *(device const float *) (m + args.pe_nb0 + args.pe_nb1);
+            out[i0] = a*c + b*neg_s;
+            out[i1] = a*s + b*c1;
+        } else {
+            out[i0] = a*c - b*s;
+            out[i1] = a*s + b*c;
+        }
+    }
+}
