+                sumi2 += y[c][jb].qs[j + QK_MXFP4/2] * kvalues_fp4[x[jb].qs[j] >>  4];                            \
+            }                                                                                                     \
+            sumf += d * (sumi1 + sumi2);                                                                          \
+        }                                                                                                         \
+        s[c] = sumf;                                                                                              \
+    }                                                                                                             \
+}
