+        ggml_metal_unwrap_reshape(gf, mm->src[1]) == ms &&
+        !ggml_metal_ranges_overlap(mm, mw) && !ggml_metal_ranges_overlap(mm, w) && !ggml_metal_ranges_overlap(mm, signs);
