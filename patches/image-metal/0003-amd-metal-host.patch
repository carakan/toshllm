+    if (![[NSFileManager defaultManager] fileExistsAtPath:dir]) {
+        return false;
+    }
+    if (!ggml_metal_library_precompiled_matches(dir, want)) {
+        return false;
+    }
+
+    const int64_t t_start = ggml_time_us();
