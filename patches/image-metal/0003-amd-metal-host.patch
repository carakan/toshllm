+
+static bool tosh_prof_on(void) {
+    int s = atomic_load_explicit(&g_tosh_prof.state, memory_order_relaxed);
+    if (s == 0) {
+        const char * v = TOSH_ENV("TOSH_MOE_PROFILE");
+        s = (v && v[0] == '1') ? 2 : 1;
+        atomic_store_explicit(&g_tosh_prof.state, s, memory_order_relaxed);
+    }
+    return s == 2;
+}
