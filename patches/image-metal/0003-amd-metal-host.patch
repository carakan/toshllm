+static const ggml_tensor * ggml_metal_unwrap_reshape(const ggml_cgraph * gf, const ggml_tensor * t) {
+    while (t && t->op == GGML_OP_RESHAPE) {
+        if (ggml_metal_use_count(gf, t) != 1) {
+            return nullptr;
+        }
+        t = t->src[0];
+    }
