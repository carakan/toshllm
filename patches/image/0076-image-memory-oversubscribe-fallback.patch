+        // Keep that behavior as the last resort instead of failing the segment: the
+        // staging allocation below either pages like before, or fails with the real
+        // allocation error rather than this estimate.
+        LOG_WARN("execution engine oversubscribing %s: need %.2f MB device, %s free; continuing, the render pages under pressure",
+                 ggml_backend_name(request.compute_backend),
+                 available.required_device_bytes / (1024.0 * 1024.0), device_bytes.c_str());
